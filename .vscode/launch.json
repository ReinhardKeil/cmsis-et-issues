{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Arm-FVP@GDB (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/Zephyr_app/Corstone-320-FVP/Debug/zephyr/zephyr.elf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off",
                "tbreak main"
            ],
            "target": {
                "server": "FVP_Corstone_SSE-320",
                "environment": {
                    "VIRTUAL_ENV": "${workspaceFolder}/../../.venv",
                    "PATH": "${workspaceFolder}/../../.venv/Scripts;${env:APPDATA}/uv/python/cpython-3.13-windows-x86_64-none;${env:PATH}"
                },
                "serverParameters": [
                    "-D",
                    "--plugin",
                    "${env:AVH_FVP_PLUGINS}/GDBServer.dll",
                    "-C",
                    "GDBServer.port=3333",
                    "-f",
                    "fvp.config",
                    "-a",
                    "out/Zephyr_app/Corstone-320-FVP/Debug/zephyr/zephyr.elf"
                ],
                "port": "3333",
                "serverStartupDelay": 3000
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                // To re-sync after changing target or build type, set auto, update
                // debug configurations, then restore the environment and startup delay.
                "updateConfiguration": "manual"
            }
        },
        {
            "name": "Arm-FVP@GDB (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/",
            "program": "out/Zephyr_app/Corstone-320-FVP/Debug/zephyr/zephyr.elf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off"
            ],
            "target": {
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        }
    ]
}
