{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Arm-FVP@GDB (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/Zephyr_app/Corstone-320-FVP/Debug/zephyr/zephyr.elf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off",
                "tbreak main"
            ],
            "target": {
                "server": "FVP_Corstone_SSE-320",
                "serverParameters": [
                    "-D",
                    "--plugin",
                    "${env:AVH_FVP_PLUGINS}/GDBServer.dll",
                    "-C",
                    "GDBServer.port=3333",
                    "-C",
                    "mps4_board.uart0.out_file=-",
                    "-C",
                    "mps4_board.uart0.unbuffered_output=1",
                    "-a",
                    "out/Zephyr_app/Corstone-320-FVP/Debug/zephyr/zephyr.hex"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        },
        {
            "name": "Arm-FVP@GDB (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/",
            "program": "out/Zephyr_app/Corstone-320-FVP/Debug/zephyr/zephyr.elf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off"
            ],
            "target": {
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        }
    ]
}
