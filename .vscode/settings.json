{
    "cmsis-csolution.environmentVariables": {
        "ZEPHYR_BASE": "$HOME/benchresults/zephyr-repo/zephyr",
        "VIRTUAL_ENV": "$HOME/benchresults/zephyr-repo/.venv",
        "PATH": "$HOME/benchresults/zephyr-repo/.venv/Scripts;$HOME/AppData/Roaming/uv/python/cpython-3.13-windows-x86_64-none"
    },
    "debug.hideSlowPreLaunchWarning": true,
    "debug.showInStatusBar": "never",
    "memory-inspector.addressPadding": "32bit",
    "memory-inspector.groupings.groupsPerRow": "Autofit",
    "memory-inspector.groupings.MAUsPerGroup": 4,
    "memory-inspector.scrollingBehavior": "Auto-Append",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/out/Zephyr_app/Corstone-320-FVP/Debug"
    ]
}
