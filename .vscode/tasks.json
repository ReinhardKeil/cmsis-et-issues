{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMSIS Load",
            "type": "shell",
            "command": "echo CMSIS Load: images are loaded by the FVP model when CMSIS Run starts.",
            "options": {
                "cwd": "${workspaceFolder}/",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMSIS Run",
            "type": "shell",
            "command": "FVP_Corstone_SSE-320",
            "options": {
                "cwd": "${workspaceFolder}/",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "args": [
                "-f",
                "fvp.config",
                "-a",
                "out/Zephyr_app/Corstone-320-FVP/Debug/zephyr/zephyr.elf"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMSIS Load+Run",
            "dependsOn": [
                "CMSIS Load",
                "CMSIS Run"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
